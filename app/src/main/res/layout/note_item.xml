<?xml version="1.0" encoding="utf-8"?>
<!--
=========================================================================
CRITICAL: layout_height MUST be "wrap_content".
- If set to "match_parent", 1 single note will take up your entire phone screen!
- "wrap_content" guarantees each card only occupies its needed vertical space.
=========================================================================
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="12dp"
    android:layout_margin="6dp"
    android:background="#EEEEEE">
    <!-- Light gray background so you can see the card box container -->

    <!-- Displays the primary note content / body text -->
    <TextView
        android:id="@+id/tvNoteTxt"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Note text goes here"
        android:textSize="16sp"
        android:textStyle="bold" />

    <!-- Displays the creation or modification timestamp -->
    <TextView
        android:id="@+id/tvNoteDate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Date &amp; Time"
        android:textSize="12sp"
        android:textColor="#666666" />

    <!-- Action buttons row inside the card (Edit and Delete) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <!-- Weight=1 splits horizontal space equally (50/50) between both buttons -->
        <Button
            android:id="@+id/btnEdit"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Edit" />

        <Button
            android:id="@+id/btnDelete"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Delete" />
    </LinearLayout>

</LinearLayout>
